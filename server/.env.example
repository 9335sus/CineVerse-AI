NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cineverse?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
# TMDB: use EITHER the v4 Read Access Token OR the v3 API key
TMDB_READ_TOKEN=
TMDB_API_KEY=

# AI (optional). Provider: anthropic | openai | none  (openai = any OpenAI-compatible API)
# With "none" or a missing key, the app uses the rule-based fallback for explanations.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Only for AI_PROVIDER=openai (change for other compatible providers)
AI_BASE_URL=https://api.openai.com/v1
